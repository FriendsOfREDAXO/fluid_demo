{
    "name": "friendsofredaxo/fluid_demo",
    "description": "Ergänzung für das REDAXO-6-AddOn fluid: Demo-Modus – Besucher bearbeiten die Website zum Ausprobieren – nach Klick auf „Demo starten“ und Bot-Prüfung, gespeichert wird nichts",
    "type": "redaxo-addon",
    "license": "MIT",
    "keywords": ["redaxo", "redaxo-addon", "redaxo6", "fluid", "demo", "frontend-editing"],
    "authors": [
        { "name": "Thomas Skerbis", "homepage": "https://klxm.de" },
        { "name": "Friends Of REDAXO", "homepage": "https://friendsofredaxo.github.io" }
    ],
    "require": {
        "php": "^8.5",
        "redaxo/core": "^6.0@dev",
        "friendsofredaxo/fluid": "^1.0@dev"
    },
    "autoload": {
        "psr-4": {
            "FriendsOfRedaxo\\FluidDemo\\": "src/"
        }
    },
    "extra": {
        "redaxo": {
            "addon-class": "FriendsOfRedaxo\\FluidDemo\\DemoAddon"
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    }
}
